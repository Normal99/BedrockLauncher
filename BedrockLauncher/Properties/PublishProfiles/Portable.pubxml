<?xml version="1.0" encoding="utf-8"?>
<!--
Self-contained ("portable") publish. The output folder includes the .NET runtime,
so it runs on Windows without installing the .NET Desktop Runtime or needing admin.
The bundled native launcher DLLs are x64-only, so only win-x64 is supported.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>bin\Portable\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>
</Project>
